{
  "name": "opencode-acp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Expose external ACP agents as OpenCode providers",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.12.0",
    "@ai-sdk/provider": "3.0.8",
    "@opencode/plugin": "2.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kobalte/core": "0.13.13",
    "@types/node": "^22.10.0",
    "prettier": "^3.10.1",
    "solid-js": "^1.9.20",
    "typescript": "^5.7.0",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.17"
  }
}
